# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会提交。
#
# 只需要填「你实际要用的那一家」的 Key。
# 在控制台「设置 → 模型服务」里切换服务商时，程序会按服务商去取对应的变量，
# 不会把甲家的 Key 发到乙家（那只会换来 401）。

# —— DeepSeek（默认）——
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# —— 通义千问 / 阿里云百炼 ——
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# —— 豆包 / 火山方舟 ——
# ARK_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# —— 腾讯混元（元宝同源底座）——
# HUNYUAN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# —— 智谱 GLM ——
# ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx

# —— Kimi / 月之暗面 ——
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# —— 硅基流动 SiliconFlow ——
# SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# —— 通用兜底：任何 OpenAI 兼容端点都可以用这个 ——
# AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：覆盖 config.yaml 中的默认值
# CJ_PROVIDER=qwen                # 等价于控制台里选服务商
# DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEEPSEEK_MODEL=qwen-plus
# CJ_CDP_URL=http://127.0.0.1:9222
# CJ_SITE=changjiang
